<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 9+ blocks cleartext HTTP by default, so a dev backend on plain
    http:// fails silently and the app falls back to its sample catalogue.
    Cleartext is permitted only for local development hosts; everything else
    still has to be HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.18.131</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
