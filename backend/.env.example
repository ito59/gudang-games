APP_NAME=GudangGames
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bandar_games
DB_USERNAME=root
DB_PASSWORD=
# Only set these on a MySQL older than 5.5.3, which has no utf8mb4. Leave them
# unset everywhere else: MySQL's "utf8" is three bytes and cannot store emoji
# — an insert containing one fails outright rather than being trimmed.
# DB_CHARSET=utf8
# DB_COLLATION=utf8_general_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google sign-in. The web OAuth client ID — the app is handed this over
# /api/v1/config, so setting it here is all it takes to turn the button on.
# Empty leaves Google sign-in off. See docs/google-sign-in.md.
GOOGLE_SERVER_CLIENT_ID=

# Named on /policy and /terms. The email is where privacy and account
# deletion requests go, so it must be a mailbox someone reads.
LEGAL_OPERATOR="PT LDS"
LEGAL_CONTACT_EMAIL=
LEGAL_WEBSITE=https://lds.co.id
# The landing page's Google Play button; empty shows "coming soon".
PLAY_STORE_URL=

# Only for an iOS build.
GOOGLE_IOS_CLIENT_ID=

# Audiences the server accepts. Defaults to the two IDs above; set this only
# to accept something else as well.
GOOGLE_CLIENT_IDS=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_PORT=8080
REVERB_SCHEME=http

# Push notifications. Leave unset and the app still works — the phones simply
# do not buzz, and each skipped notification is logged. The credentials file
# comes from Firebase Console → Project settings → Service accounts, and must
# not be committed: it can notify every install.
FCM_PROJECT_ID=
FCM_CREDENTIALS=
